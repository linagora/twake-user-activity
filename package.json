{
  "name": "twake-user-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrument.ts src/main.ts",
    "start": "node --import ./dist/instrument.js dist/main.js"
  },
  "dependencies": {
    "@linagora/twake-node-server": "^1.0.0",
    "@sentry/node": "^11.4.0",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
